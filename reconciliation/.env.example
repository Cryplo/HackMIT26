# Synthetic data only: no auth or payments. Never use real financial/personal data.
RECONCILIATION_SYNTHETIC_ONLY=true
RECONCILIATION_INTAKE_MODE=demo
RECONCILIATION_EXTRACTION_MODE=demo
RECONCILIATION_MODE=simulated
RECONCILIATION_APP_ORIGIN=http://127.0.0.1:3000
# Hostnames (comma separated, no scheme or port) allowed to load `next dev` assets
# when the dev server is reached through a tunnel or another machine, e.g.
# RECONCILIATION_DEV_ORIGINS=**.example-tunnel.com,192.168.1.10
RECONCILIATION_DEV_ORIGINS=
# For full live service use, change all three modes above to live.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts
# Choose Azure OR direct OpenAI. All three Azure fields are required together.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Direct OpenAI alternative; unnecessary with Azure configured.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
# Reviewer-facing decision narratives. live requires Azure or OpenAI credentials and a non-simulated mode.
RECONCILIATION_JUSTIFICATION_MODE=simulated
JUSTIFICATION_MODEL=gpt-4.1-mini
# Choose one Jev provider. Gateway: typesafe-ai/jev; direct: jev-latest.
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=typesafe-ai/jev
# Elasticsearch is not required. Candidates are retrieved from stored receipts.
# Local private directory. Never use public/.
# RECONCILIATION_INTAKE_DEMO_DIR=.intake-demo
