# One Vercel AI Gateway key powers Jev and the text helper.
# Create a key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
TEXT_MODEL=inception/mercury-2.5

# Voice extension (Deepgram key needs Member permission for temporary tokens)
DEEPGRAM_API_KEY=
VOICE_MAX_REQUESTS=120
