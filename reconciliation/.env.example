# Explicit synthetic-data-only gate, required in both modes.
RECONCILIATION_SYNTHETIC_ONLY=true
# demo = local persistent files + SIMULATED extraction; live = Supabase + OpenAI
RECONCILIATION_INTAKE_MODE=demo
# Required only for live mode (server-only):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
# Optional canonical origin behind a reverse proxy:
RECONCILIATION_APP_ORIGIN=http://localhost:3000
# Optional local demo directory (outside public/):
# RECONCILIATION_INTAKE_DEMO_DIR=.intake-demo
